#!/bin/sh
_thisdir=$(
  cd $(dirname $0)
  pwd
)

_ifname=wlan0

settings() {
  command xset r rate 330 50
}

statusbar() {
  bat=$(cat /sys/class/power_supply/BATT/capacity)
  free_mem=$(awk '/MemFree/ { printf "%.2f\n", $2/1024/1024 }' /proc/meminfo)
  available_mem=$(awk '/MemAvailable/ { printf "%.2f\n", $2/1024/1024 }' /proc/meminfo)
  avg_load=$(awk '{print $1}' /proc/loadavg)
  free_disk=$(df -h / | grep dev | cut -f 8 -d\ )
  SSID=$(command iwctl station wlan0 show | awk '/Connected network/ {print $3}')

  command xsetroot -name " $(date '+%H:%M')   ${SSID}   ${free_mem}/${available_mem}G   $avg_load   $free_disk   $bat%"
}

cron() {
  i=0
  while true; do
    [ $((i % 2)) -eq 0 ] && statusbar

    [ $((i % 600)) -eq 0 ] && command feh --randomize --bg-fill $wallpapers/*.png

    sleep 2
    i=$((i + 2))
  done
}

startup() {
  [ $1 ] && sleep $1
  command st -e tmux &
}

daemons() {
  [ $1 ] && sleep $1
  command flameshot &
  command xbanish -m ne &
  command fcitx5 -d 2>/dev/null &
  command picom -b
}

settings &
startup &
daemons &
cron &
